.idea/
.vscode/
*.swp
*.swo

# Datasets
test/
train/
data/raw/
data/manifests/*.csv

# ML training run artifacts (checkpoints, per-run logs) - see experiments/README.md
experiments/runs/
# Calibration run artifacts - generated locally and intentionally not committed.
experiments/calibration/
# Step 7 ablation comparison artifacts are tracked.
# Large training runs/checkpoints remain ignored above.
# See .claude/specs/07-ablation-experiment.md
experiments/ablation/*
!experiments/ablation/step7/
!experiments/ablation/step7/comparison.md
!experiments/ablation/step7/comparison.json
!experiments/ablation/step7/run_manifest.json
*.pt
*.pth
*.ckpt


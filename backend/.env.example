# SignalScope Backend Environment Configuration

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="SignalScope API"
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./signalscope.db

# Storage
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_BYTES=10485760

# Model Configuration (Configurable by ML team)
MODEL_VERSION=signalscope-v1
MODEL_WEIGHTS_PATH=model/weights/signalscope_detector.pth
DECISION_THRESHOLD=0.50

# Preprocessing Dimensions & Normalization (Configure to match ML model specs)
# Note: Defaults provided are standard placeholders until ML team provides final model contract
MODEL_INPUT_WIDTH=224
MODEL_INPUT_HEIGHT=224
MODEL_NORM_MEAN=[0.485, 0.456, 0.406]
MODEL_NORM_STD=[0.229, 0.224, 0.225]

# Calibration (Set to 'none' or leave unconfigured until validation calibration parameters exist)
CALIBRATION_ENABLED=false
CALIBRATION_METHOD=none
CALIBRATION_TEMPERATURE=1.0

